    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3"
